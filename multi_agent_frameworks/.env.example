# OpenRouter / OpenAI-compatible chat endpoint.
# Copy this file to .env and fill in values locally.
#
# OpenRouter default:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
#
# Use exactly one base URL and one API key pair for all routed models.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=

# Default model used by the legacy `uv run python -m cli run` shortcut.
# Override per run with `--model`.
OPENAI_MODEL=openai/gpt-4o-mini

# Optional default generation controls.
OPENAI_TEMPERATURE=0
# Direct OpenAI evaluate runs support standard or flex. Compatible providers
# ignore standard and reject flex. Batch is a separate asynchronous API.
OPENAI_SERVICE_TIER=standard

# Runtime controls.
# MAX_COMPLETION_TOKENS caps generated tokens per LLM call.
# MAX_RETRIES is the number of retries after an initial failed/malformed call.
# After retries are exhausted, the current sample is marked Error and the run continues.
MAX_COMPLETION_TOKENS=1024
MAX_RETRIES=3

# Evaluator concurrency and readable-manifest checkpoint defaults.
EVAL_CASE_WORKERS=4
EVAL_MAX_IN_FLIGHT_LLM=20
EVAL_CHECKPOINT_EVERY=250

# Evaluator early-stop guardrails.
# These prevent a full 500-row run from continuing when request errors look systemic.
EVAL_ERROR_STOP_FAILED_LLM_ATTEMPTS=10
EVAL_ERROR_STOP_FAILED_RECORDS=3
EVAL_ERROR_STOP_RATE=0.5
EVAL_ERROR_STOP_MIN_RECORDS=10

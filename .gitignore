# EvalRing specific gitignore

# Allow requirements files
!requirements.txt
!requirements-dev.txt
!requirements-examples.txt

# Standard Python ignores
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.tmp/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
Pipfile.lock

# PEP 582
__pypackages__/

# Environments
.env
.venv
.venv_EvalRing/
env/
venv/
ENV/
env.bak/
venv.bak/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project specific
logs/
results/
outputs/
checkpoints/
models/
*.pkl
*.joblib

# EvalRing run outputs (auto-generated, may contain results/keys)
_EvalRing/
.deepeval/

# Large datasets — do not commit raw data files
*.csv
*.tsv
*.parquet
*.jsonl
# but allow small example/fixture files if explicitly added
!multi_agent_frameworks/dataset/positive-negative-final-datasets/dataset1_positive_balanced_100_seed42.csv
!multi_agent_frameworks/dataset/positive-negative-final-datasets/negative_real_synthetic_balanced_100_seed42.csv

# Keep curated evaluation artifacts while runtime logs remain ignored.
!multi_agent_frameworks/test-results/
!multi_agent_frameworks/test-results/**

# CounselBench is its own separate repo
CounselBench/

# Egg-info (generated by pip install -e .)
src/*.egg-info/

# Legacy / scratch directories in examples
src/example/suicide_detection/deepeval/
src/example/suicide_detection/data_load
src/example/suicide_detection/src/
src/example/suicide_detection/results/
src/example/suicide_detection/ground_truth/data/
src/example/suicide_detection/ground_truth/logs/
src/example/suicide_detection/ground_truth/results/

# Config files that may contain API keys
src/example/suicide_detection/ground_truth/config.json

# dir start with underdash
_*/
